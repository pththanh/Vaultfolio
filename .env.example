# Postgres. Local: `npm run db:up` (docker compose). Production: Neon connection string.
DATABASE_URL=postgres://vaultfolio:vaultfolio@localhost:5432/vaultfolio
# Optional: direct (non-pooled) URL used by migrations. Neon's Vercel integration sets it.
DATABASE_URL_UNPOOLED=

# Optional: database for `npm run test:db` (name must end in _test). Defaults to local docker.
TEST_DATABASE_URL=

# Auth.js. Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Owner account created by `npm run db:seed`.
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). `openssl rand -hex 32`
CRON_SECRET=

# Price providers (step 6 — server-side only, never exposed to the client).
DNSE_API_KEY=
DNSE_API_SECRET=
COINGECKO_API_KEY=
FINHAY_API_KEY=
BINGX_API_KEY=
BINGX_API_SECRET=
