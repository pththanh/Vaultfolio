{
  "name": "vaultfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://vaultfolio:vaultfolio@localhost:5432/vaultfolio_test} vitest run",
    "test:db:setup": "docker compose exec db createdb -U vaultfolio vaultfolio_test; DATABASE_URL_UNPOOLED= DATABASE_URL=postgres://vaultfolio:vaultfolio@localhost:5432/vaultfolio_test drizzle-kit migrate",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:up": "docker compose up -d db",
    "prices:backfill": "tsx --conditions=react-server scripts/backfill-prices.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "user:create": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "otpauth": "^9.6.0",
    "papaparse": "^5.7.1",
    "postgres": "^4.1.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
